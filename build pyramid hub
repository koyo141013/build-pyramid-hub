local Utils = {}

function Utils.setSpeed(n)
    local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if h then h.WalkSpeed = n end
    _G.WalkSpeed = n
end

function Utils.setJump(n)
    local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if h then h.JumpPower = n end
end

LP.CharacterAdded:Connect(function(c)
    task.wait(0.5)
    if _G.WalkSpeed then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = _G.WalkSpeed end
    end
end)

-- Noclip (v2: Stepped + Heartbeat 둘 다, 리스폰/들고있는 블록 대응)
_G.Noclip = false
local function applyNoclip()
    if not _G.Noclip then return end
    local char = LP.Character
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
        end
    end
    -- HumanoidRootPart가 간혹 씹혀서 별도 처리
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CanCollide = false end
end
RunService.Stepped:Connect(applyNoclip)
RunService.Heartbeat:Connect(applyNoclip)
-- 혹시 Stepped이 안 먹는 익스플로잇 대비 폴링 루프
task.spawn(function()
    while true do
        task.wait(0.1)
        applyNoclip()
    end
end)

-- Fly (간단)
_G.Fly = false
local flyBV = nil
task.spawn(function()
    while true do
        task.wait(0.05)
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if _G.Fly and hrp then
            if not flyBV then
                flyBV = Instance.new("BodyVelocity")
                flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                flyBV.Velocity = Vector3.zero
                flyBV.Parent = hrp
            end
            local cam = Workspace.CurrentCamera
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end
            flyBV.Velocity = dir * 60
        else
            if flyBV then flyBV:Destroy() flyBV = nil end
        end
    end
end)

