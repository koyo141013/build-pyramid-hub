local function makeGui()
    pcall(function()
        local old = game:GetService("CoreGui"):FindFirstChild("PyramidHelper")
        if old then old:Destroy() end
    end)
    local gui = Instance.new("ScreenGui")
    gui.Name = "PyramidHelper"
    gui.ResetOnSpawn = false
    pcall(function() gui.Parent = game:GetService("CoreGui") end)
    if not gui.Parent then gui.Parent = LP:WaitForChild("PlayerGui") end

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 340)
    frame.Position = UDim2.new(0, 20, 0, 100)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui

    local function btn(text, y, cb)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -20, 0, 32)
        b.Position = UDim2.new(0, 10, 0, y)
        b.Text = text
        b.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.SourceSansBold
        b.TextSize = 15
        b.Parent = frame
        b.MouseButton1Click:Connect(function() cb(b) end)
        return b
    end

    btn("AutoFarm: OFF", 10, function(b)
        _G.AutoFarm = not _G.AutoFarm
        b.Text = "AutoFarm: " .. (_G.AutoFarm and "ON" or "OFF")
    end)
    btn("AutoGym: OFF", 48, function(b)
        _G.AutoGym = not _G.AutoGym
        b.Text = "AutoGym: " .. (_G.AutoGym and "ON" or "OFF")
    end)
    btn("Speed 32", 86, function() Utils.setSpeed(32) end)
    btn("Speed 60", 122, function() Utils.setSpeed(60) end)
    btn("Noclip: OFF", 158, function(b)
        _G.Noclip = not _G.Noclip
        b.Text = "Noclip: " .. (_G.Noclip and "ON" or "OFF")
    end)
    btn("Fly: OFF", 194, function(b)
        _G.Fly = not _G.Fly
        b.Text = "Fly: " .. (_G.Fly and "ON" or "OFF")
    end)
    btn("Remotes: OFF(안전)", 232, function(b)
        _G.UseRemotes = not _G.UseRemotes
        b.Text = "Remotes: " .. (_G.UseRemotes and "ON(위험)" or "OFF(안전)")
    end)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 40)
    label.Position = UDim2.new(0, 10, 0, 272)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(180, 180, 180)
    label.TextWrapped = true
    label.TextSize = 12
    label.Text = "프리즈나면 Remotes OFF + Farm만 켜기\nNoclip v2 적용됨"
    label.Parent = frame
end
